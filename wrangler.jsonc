{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firemapper",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  // The app shell is static and deploys only when code changes. Every
  // generation the pipeline publishes lands in the DATA bucket instead, so a
  // half-hourly data refresh costs zero deploys — see docs/DEPLOYMENT.md.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Assets are served BEFORE the Worker by default, so a stale web/dist/data
    // left in a build would shadow the bucket and pin the site to whatever was
    // committed. Data must always come from R2.
    //
    // "**" is required, not "*": generation paths nest
    // (/data/gen-<ts>/tracks/<id>.json) and a single-segment glob left them to
    // the asset layer, which answered HEAD probes with 503.
    // /hd is the Sentinel Hub tile proxy (worker/index.ts). Without it here the
    // asset layer answers every tile with index.html and a 200 — and MapLibre
    // discards a non-image raster tile WITHOUT firing `error`, so the compare
    // mode goes blank with nothing in the console. Any new Worker route must be
    // added here too; web/tests/wrangler_routes.test.ts enforces that.
    "run_worker_first": ["/data/**", "/hd", "/api/historical-hotspots", "/api/geocode"]
  },
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "firemapper-data" }
  ],
  // Drives the data refresh. GitHub throttles scheduled workflows on public
  // repos hard enough to make the nominal cadence fiction — measured over 52.8h
  // on 2026-08-04, a */15 cron produced 30 runs against 211 nominal, median gap
  // 81 min. Cloudflare fires these reliably, so the cron in refresh-fast.yml is
  // now only a fallback for when this Worker is broken.
  //
  // The GH_DISPATCH_TOKEN secret this needs is set out of band
  // (`wrangler secret put`), never in this file.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GEOCODE_RATE_GATE", "class_name": "GeocodeRateGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GeocodeRateGate"] }
  ],
  // Per-visitor caps on the /api/* proxies (worker/visitor_limit.ts). A
  // dashboard WAF rate-limiting rule cannot be attached to a workers.dev
  // hostname, so the same infrastructure is used through this binding
  // instead. Counters are per Cloudflare location and keyed on client IP;
  // both handlers make ONE upstream call per user action, so these numbers
  // are "a human clicking around", not a quota. period must be 10 or 60.
  // namespace_id is any positive integer unique within this Worker.
  "ratelimits": [
    { "name": "HISTORICAL_VISITOR_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "GEOCODE_VISITOR_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Required for the Worker to write logs at all: without it, console output
  // exists only in a live `wrangler tail`, i.e. only while someone is watching.
  // The scheduled handler THROWS on a failed dispatch rather than logging,
  // precisely so the failure is a recorded invocation error and not just a line
  // here — but the line is what tells you which HTTP status it was.
  //
  // Retention is 3 days on the free plan. That is enough to diagnose a failure
  // once noticed; it is NOT a monitor. See docs/DEPLOYMENT.md for what actually
  // detects a dead refresh.
  "observability": {
    "enabled": true
  }
}
