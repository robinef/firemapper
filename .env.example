# FIRMS_MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key
# Optional: how many days of VIIRS history to seed as past-fire scars (default
# 30). NRT covers only ~the last 2 months, so values much above ~60 gain nothing.
# FIRMS_HISTORY_DAYS=30
# Optional Meteosat liveness tier (needs free EUMETSAT NRT licence)
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# Optional HD before/after imagery — Sentinel-2 10 m instead of the keyless
# MODIS 250 m default. Free Copernicus Data Space account.
#   1. Sign in → https://shapps.dataspace.copernicus.eu/dashboard/#/
#   2. Add new configuration → "Create configuration based on:" pick the
#      "Simple Sentinel-2 L2A template" (built-in — NOT a BYOC/collection UUID).
#      Any other path leaves the layer pointing at an empty collection id
#      (00000000-…) and the WMS returns "Collection not found".
#   3. Copy the instance id from Service endpoints. The template's true-colour
#      layer id is TRUE_COLOR (underscore) — set SENTINELHUB_LAYER to match.
# Only the instance id + layer id are needed (the instance id is the WMS token).
SENTINELHUB_INSTANCE_ID=
SENTINELHUB_LAYER=TRUE_COLOR
