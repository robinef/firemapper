# Python
__pycache__/
.venv/
.pytest_cache/
*.pyc

# Node / web
# No trailing slash: a stray *symlink* named node_modules (an editor, a
# worktree helper, a mistyped `ln -s`) is not a directory, so `node_modules/`
# does not match it and `git add -A` tracks it — which is how an absolute,
# machine-local path reached main in #166.
node_modules

# Generated data + secrets (never commit)
data/
web/public/data/
.env

# Local dev / agent tooling (not part of the project)
.claude/
.lean-ctx/
scratch/
docs/superpowers/
.superpowers/
.superset/
*.bak
.DS_Store
web/dist/

# wrangler local state (dev server cache, asset manifests)
.wrangler/
.firecrawl/
